{
  "name": "septicaudit-tally-webhook",
  "version": "1.0.0",
  "private": true,
  "description": "SepticAudit Tally webhook — Google Cloud Functions Gen2 (HTTP)",
  "main": "lib/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gcp-build": "npm run build",
    "start": "functions-framework --target=tallyWebhook --source=lib",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:fixtures": "node --import tsx scripts/run-fixtures.ts"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.6",
    "@supabase/supabase-js": "^2.49.8",
    "resend": "^4.5.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}
